# ==============================================================================
# Analytical Engine - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' before running Docker Compose for the first time:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL 17 Database Settings
# ------------------------------------------------------------------------------
POSTGRES_DB=analytical_engine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_example

# ------------------------------------------------------------------------------
# 2. Security & JWT Authentication
# Note: The secret key must be at least 32 characters long (256 bits)
# ------------------------------------------------------------------------------
JWT_SECRET=SuperSecretKeyForAnalyticalEngineCoursework2026AtLeast32Chars!
JWT_ISSUER=AnalyticalEngine
JWT_AUDIENCE=AnalyticalEngineClient
JWT_EXPIRATION_MINUTES=120

# ------------------------------------------------------------------------------
# 3. SuperAdmin Account for Initial Seeding (SeedAdmin)
# Automatically created during the first database migration run
# ------------------------------------------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=SuperAdminPassword2026!

# ------------------------------------------------------------------------------
# 4. Service Ports (External access on the host machine)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=5000
DB_PORT=5432